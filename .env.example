# Existing AI Studio / application variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ============================================================
# PORTFOLIO CONTACT FORM — VERCEL SERVER-SIDE VARIABLES
# ============================================================
# IMPORTANT:
# - Do NOT prefix these with VITE_.
# - Do NOT put these values in React/browser code.
# - Configure them in Vercel -> Project -> Settings -> Environment Variables.

# Exact Google Apps Script Web App URL from Deploy -> Web app.
# It MUST end in /exec, never /dev.
GOOGLE_APPS_SCRIPT_CONTACT_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Generated/preserved by setupContactBackend() in Apps Script.
# Copy the exact value from the Apps Script execution log into Vercel.
CONTACT_FORM_SECRET="COPY_EXACT_SECRET_FROM_APPS_SCRIPT_EXECUTION_LOG"
