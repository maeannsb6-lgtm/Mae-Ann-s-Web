# Portfolio contact form — server-side Vercel variables only.
# Never prefix these values with VITE_. Never put service keys in browser code.

# Option A: secure inquiry storage in Supabase.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Option B: existing Google Sheets + acknowledgement email workflow.
GOOGLE_APPS_SCRIPT_CONTACT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
CONTACT_FORM_SECRET=YOUR_APPS_SCRIPT_SHARED_SECRET

# Optional: notify an n8n workflow after an inquiry is recorded.
N8N_CONTACT_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/YOUR_WEBHOOK_PATH
N8N_CONTACT_WEBHOOK_SECRET=YOUR_OPTIONAL_WEBHOOK_SECRET
